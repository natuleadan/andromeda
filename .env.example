# Environment Variables for Natuleadan Andromeda (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required keys via `gh secret set <KEY> --repo natuleadan/andromeda` (fail-fast if missing).

# [var] Daemon environment (development | staging | production)
ANDROMEDA_ENV=development
# [var] Local daemon control socket path
ANDROMEDA_SOCKET_PATH=/tmp/andromeda.sock
# [secret] Bunny.net master API key
BUNNY_API_KEY=CHANGE_ME
# [secret] Better Stack telemetry source token
BETTER_STACK_SOURCE_TOKEN=CHANGE_ME
